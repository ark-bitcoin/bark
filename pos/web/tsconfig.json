{
	"compilerOptions": {
		"target": "ES2022",
		"module": "ESNext",
		"moduleResolution": "bundler",
		"strict": true,
		"noUncheckedIndexedAccess": true,
		"verbatimModuleSyntax": true,
		"isolatedModules": true,
		"skipLibCheck": true,
		"noEmit": true,
		"types": ["vite/client", "vite-plugin-pwa/client"],
		"paths": { "$lib/*": ["./src/lib/*"] }
	},
	"include": ["src/**/*", "vite.config.ts"]
}
